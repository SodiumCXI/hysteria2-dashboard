{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "StorePath": "/etc/hysteria/app.json",
    "DatabasePath": "/app/data/traffic.db",
    "DashboardPath": "/opt/hysteria2-dashboard"
  },
  "Hysteria2": {
    "ConfigPath": "/etc/hysteria/config.yaml",
    "TrafficApiUrl": "http://host.docker.internal:9999"
  },
  "SSH": {
    "Host": "host.docker.internal",
    "User": "hysteria",
    "KeyPath": "/app/ssh_key",
    "Port": 22
  }
}
